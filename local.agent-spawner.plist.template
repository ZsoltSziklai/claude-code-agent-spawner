<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.agent-spawner</string>

    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.claude/agent-queue/bin/claude-agent-spawner</string>
    </array>

    <key>WatchPaths</key>
    <array>
        <string>__HOME__/.claude/agent-queue/new</string>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <!-- ⚠️ A `WatchPaths` ONMAGABAN NEM ELEG. A launchd a futas kozben erkezo
         WatchPaths-esemenyt NEM allitja sorba: eldobja. 2026-10-03-an emiatt
         maradt ki egy 2 masodperccel kesobb kiirt spec — a `new/` kezi
         `touch`-olasa inditotta el. Ugyanaz a hibaosztaly, amit a relay
         2026-08-31-en kapott; ott a `StartInterval` volt a megoldas, es a
         spawnernel is az. A kihagyott kor igy ingyen van (a spec a `new/`-ben
         marad), a parhuzamos futas viszont nem — ezert a script
         egypeldanyos lockot is kap. -->
    <key>StartInterval</key>
    <integer>20</integer>

    <key>ThrottleInterval</key>
    <integer>1</integer>

    <key>StandardOutPath</key>
    <string>__HOME__/.claude/agent-queue/launchd.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/.claude/agent-queue/launchd.stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>
</dict>
</plist>
