#!/bin/zsh
# fork-agent — beszélgetés-ág: leszármaztat egy új remote agentet a HÍVÓ
# session beszélgetésével együtt.
#
#   fork-agent <suffix> [--worktree] [--cwd DIR] [--model M] [--effort E]
#                       [--summary] [<prompt>]
#
# A `claude --resume <id> --fork-session` a `git checkout -b` megfelelője:
# új session id, a szülő előzményével. A /new-agent ezzel szemben üres lappal
# indít — a gyerek örökli a nevet és a kezelhetőséget, de nem tudja, amit a
# szülő tud.
#
# A tmux session neve `agent-<név>`, hogy a meglévő /kill-agent és
# /close-agent kaszkádja elérje: a szülő lezárásakor a fork is megsemmisül.
# A live/ registrybe NEM regisztrálunk — egy feature branch nem az, amit egy
# watchdog reboot után magától feltámaszt.
emulate -L zsh
setopt nullglob
set -u

export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

# A setup-token inference-only, és NÉMÁN kikapcsolja a Remote Controlt.
unset CLAUDE_CODE_OAUTH_TOKEN
# SOHA ne legyen TMUX nevű változó: a tmux ebből keresi a socketet.
unset TMUX

source "$(dirname "${(%):-%x}")/_agent-lib.sh"

LOG="$CLAUDE_AGENT_QUEUE/fork.log"
rotate_log "$LOG" 2>/dev/null || true
log() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" >> "$LOG"; }
die() { print -u2 "fork-agent: $*"; log "ERROR $*"; exit 1; }

JQ=$(command -v jq)        || die "jq not found"
TMUX_BIN=$(command -v tmux) || die "tmux not found"
CLAUDE=$(command -v claude) || die "claude not found"

# ---------------------------------------------------------------------------
# Szülő azonosítása — forkolni csak élő sessionből lehet
# ---------------------------------------------------------------------------
PARENT_SID="${CLAUDE_CODE_SESSION_ID:-}"
PARENT_NAME="${CLAUDE_AGENT_NAME:-}"
[[ -n "$PARENT_SID"  ]] || die "nincs CLAUDE_CODE_SESSION_ID — forkolni csak élő Claude Code sessionből lehet"
[[ -n "$PARENT_NAME" ]] || die "nincs CLAUDE_AGENT_NAME — ez a session nem az agent-rendszerből indult"

# ---------------------------------------------------------------------------
# Argumentumok
# ---------------------------------------------------------------------------
SUFFIX=""; WANT_WT=false; REQ_CWD=""; MODEL="opus"; EFFORT="high"
# ⚠️ ALAPERTELMEZES: FRISS session (2026-08-31). Korabban `full` volt, azaz a
# gyerek a szulo TELJES beszelgeteset orokolte. Ketszer bizonyitottan a szulo
# SZEREPET folytatta a sajat feladata helyett (714 soros orokolt atirat, a
# feladat a 703. sorban), es a rendszer-prompt lefokozo mondata nem volt eleg
# ellene. Az orokles hasznos, de legyen TUDATOS valasztas: --summary / --inherit.
RESUME_MODE="none"; PROMPT=""; NO_ASK=false
# A CLI sugoja szerint az ALIAS ("opus") mindig a legfrissebb modellt jelenti,
# a rogzitett azonosito ("claude-opus-5") viszont elavul. Ezert az alias a
# default; rogziteni tovabbra is lehet, ha valaki szandekosan akarja.
# A jogosultsagi mod eddig fixen "auto" volt. A hid most atadhatja — a
# `bypassPermissions`-t viszont csak kifejezett Telegram-gombnyomas utan
# (a szurest a hid vegzi: _bridge-lib.sh, spawn_from_request).
PERM="auto"
# Ki kerte a forkot? Ha egy AGENT dontott igy (nem a felhasznalo), akkor ez a
# fork ugyanolyan felugyelet nelkuli beviteli csatorna, mint a hid — es eddig
# ez volt a rendszer EGYETLEN kapu nelkuli ajtaja (a spawner mar 2026-08-29 ota
# kapuzza az agent-inditotta keresest, a fork nem).
REQUESTED_BY=""

while (( $# )); do
  case "$1" in
    --worktree)  WANT_WT=true; shift ;;
    --summary)   RESUME_MODE="summary"; shift ;;
      # ⚠️ FRISS SESSION — a 2026-08-31-i eles hiba miatt. A fork a szulo TELJES
      # beszelgeteset orokli, es a feladat egyetlen uzenetkent a VEGERE kerul.
      # Merve: egy 714 soros orokolt atiratban a feladat a 703. sorban allt, es a
      # gyerek nem azt csinalta, hanem a szulo szerepet folytatta. A rendszer-
      # prompt lefokozo mondata ODAERT, es NEM volt eleg ellene.
      --fresh)     RESUME_MODE="none"; shift ;;
      # A teljes orokles mostantol kifejezett keres (regen ez volt az alap).
      --inherit)   RESUME_MODE="full"; shift ;;
    # A hidon inditott agentnek nincs kihez visszakerdeznie: a sessionjet senki
    # nem olvassa. Kezi /fork-nal ez NEM all, ezert kapcsolo es nem alapertelmezes.
    --no-ask)    NO_ASK=true; shift ;;
    --cwd)       REQ_CWD="${2:?--cwd needs a value}"; shift 2 ;;
    --model)     MODEL="${2:?--model needs a value}"; shift 2 ;;
    --effort)    EFFORT="${2:?--effort needs a value}"; shift 2 ;;
    --permission-mode) PERM="${2:?--permission-mode needs a value}"; shift 2 ;;
    --requested-by)    REQUESTED_BY="${2:?--requested-by needs a value}"; shift 2 ;;
    --*)         die "ismeretlen kapcsoló: $1" ;;
    *)           if [[ -z "$SUFFIX" ]]; then SUFFIX="$1"; else PROMPT="$1"; fi; shift ;;
  esac
done
[[ -n "$SUFFIX" ]] || die "usage: fork-agent <suffix> [--worktree] [--cwd D] [--model M] [--effort E] [--permission-mode P] [--summary|--inherit|--fresh] [--no-ask] [--requested-by AGENT] [<prompt>]"

# ⚠️ A HAROM validator (spawner, hid, fork-agent) PERMISSION-listajanak is
# egyeznie kell — ugyanaz a drift-osztaly, ami 2026-08-26-on a modell-listaknal
# elesben elbuktatott egy hid-kerest.
case "$PERM" in
  auto|acceptEdits|plan|dontAsk|manual|bypassPermissions) ;;
  *) die "érvénytelen permission_mode: $PERM";;
esac

case "$EFFORT" in low|medium|high|xhigh|max) ;; *) die "érvénytelen effort: $EFFORT";; esac
case "$MODEL" in
  # ⚠️ A harom validator (spawner, hid, fork-agent) LISTAJANAK EGYEZNIE KELL.
  # 2026-08-26: csak a spawner kapta meg a Claude 5 csaladot, igy egy hid-keres
  # vagy /fork a TENYLEGESEN hasznalt `claude-opus-5`-tel elutasitasra kerult.
  opus|sonnet|haiku|fable) ;;
  claude-opus-4-7|claude-opus-4-8|'claude-opus-4-7[1m]'|'claude-opus-4-8[1m]') ;;
  claude-opus-5|claude-sonnet-5|claude-fable-5|claude-haiku-4-5|'claude-opus-5[1m]'|'claude-sonnet-5[1m]') ;;
  *) die "érvénytelen model: $MODEL";;
esac

# ---------------------------------------------------------------------------
# Név — a szülő prefixével, hogy a list_descendants() kaszkádja elérje
# ---------------------------------------------------------------------------
CLEAN=$(print -r -- "$SUFFIX" | tr -c 'a-zA-Z0-9_-' '-' | sed 's/-\+/-/g; s/^-//; s/-$//' | cut -c1-32)
[[ -n "$CLEAN" ]] || die "a suffix sanitizálás után üres: $SUFFIX"

# --- ONMASOLAS-OR ----------------------------------------------------------
# ⚠️ 2026-08-30: ez a pontos alakzat robbant. Egy `--summary` fork gyereke a
# szulo osszefoglalojaban levo runbookot sajat feladatnak olvasta, es UGYANAZT
# a suffixet forkolta ujra: `...-regG4-20260830-regG4-20260830`. Ha a suffix mar
# szerepel a szulo neveben, az nem uj munka, hanem onmasolas.
if [[ "-${PARENT_NAME}-" == *"-${CLEAN}-"* ]]; then
  die "önmásolás: a(z) '$CLEAN' suffix már szerepel a szülő nevében ($PARENT_NAME).
Ez a fork-bomba alakzata — ha tényleg új munka, adj neki más nevet."
fi

# --- MELYSEGKORLAT ---------------------------------------------------------
# Az onmasolas-or a megfigyelt esetet fogja; ez a hattervedelem a valtozo
# suffixu (a -> b -> c) elszabadulas ellen. A regressziós teszt legmelyebb
# legitim lanca 3 (parancskozpont -> CLI-agent -> gyerek -> unoka).
MAX_DEPTH="${CLAUDE_AGENT_MAX_DEPTH:-3}"
PDEPTH=$(fork_depth "$PARENT_NAME")
if (( PDEPTH + 1 > MAX_DEPTH )); then
  die "túl mély fork: a szülő ($PARENT_NAME) mélysége $PDEPTH, a korlát $MAX_DEPTH.
Ha ez szándékos, indítsd CLAUDE_AGENT_MAX_DEPTH=<n> mellett."
fi

# --- SEBESSEGKORLAT --------------------------------------------------------
# ⚠️ A melysegkorlat a MELY elszabadulast fogja, de egy szulo indithat 50 gyereket
# EGY szinten — ott a melyseg vegig 1 marad. A kapu ezt sem fogja meg, mert
# onbevallasos. Ez a korlat viszont determinisztikus: a sajat naplonkbol szamol,
# es nem kerdez meg senkit arrol, hogy ki kerte.
# ⚠️ A 10-es ertek MERT, nem tippelt. A regressziós futas csucsa 5 fork / 10 perc
# (2026-08-30, a fork.log-bol szamolva) — 6-tal egyetlen fork rahagyas maradt
# volna, es egy kicsit gyorsabb menet HAMIS BUKAST okozott volna. Egy hamis bukas
# a legrosszabb kimenet: fantom utan nyomozunk. A vedelem ettol nem gyengul
# erdemben — a megfigyelt bomba 3 forkot csinalt 80 masodperc alatt, egy valodi
# elszabadulas a 10-et is masodpercek alatt eleri.
MAX_BURST="${CLAUDE_AGENT_MAX_BURST:-10}"     # ennyi fork / ablak, RENDSZERSZINTEN
BURST_WIN="${CLAUDE_AGENT_BURST_WINDOW:-600}" # masodperc
if [[ -r "$LOG" ]] && (( MAX_BURST > 0 )); then
  _now=$(date -u +%s)
  # A naplo ISO-8601 UTC bejegyzeseket ir; csak a FORKED sorok szamitanak.
  _recent=$(grep FORKED "$LOG" 2>/dev/null | tail -200 | while read -r _ts _; do
    _e=$(date -u -j -f '%Y-%m-%dT%H:%M:%SZ' "$_ts" +%s 2>/dev/null) || continue
    (( _now - _e <= BURST_WIN )) && print x
  done | wc -l | tr -d ' ')
  if (( _recent >= MAX_BURST )); then
    die "sebességkorlát: $_recent fork az elmúlt $((BURST_WIN/60)) percben (max $MAX_BURST).
Ez elszabadult forkolás jele. Ha szándékos, indítsd CLAUDE_AGENT_MAX_BURST=<n> mellett."
  fi
fi

# --- KAPU: agent-kezdemenyezte fork Telegram-jovahagyast kap ---------------
# ⚠️ 2026-08-30: a spawner 2026-08-29 ota kapuzza az agent-inditotta kereseket
# (`requested_by`), a fork viszont NEM — ez volt a rendszer egyetlen orizetlen
# ajtaja, es a fork-bomba pont ezen ment ki.
#
# Nem epitunk uj gepezetet: a kerest a HID sorara irjuk, es onnan a mar meglevo,
# tesztelt ut viszi tovabb (Telegram-gomb -> jovahagyas -> vegrehajtas -> jelentes).
#
# ⚠️ KORLAT, amit ki kell mondani: ez ONBEVALLAS, mint a spawnere. Egy elszabadult
# agent egyszeruen nem adja meg a kapcsolot. A determinisztikus tartalekvedelem az
# onmasolas-or, a melysegkorlat es a sebessegkorlat — a kapu POLITIKA, nem gat.
if [[ -n "$REQUESTED_BY" ]]; then
  BR_DIR="$CLAUDE_AGENT_QUEUE/bridge/requests"
  [[ -d "$BR_DIR" ]] || die "nincs híd-sor ($BR_DIR) — kapuzott forkot nem tudok beadni"
  RID="fork-${CLEAN}-$(date -u +%Y%m%d%H%M%S)"
  RID="${RID[1,48]}"
  "$JQ" -n --arg p "$PARENT_NAME" --arg t "${PROMPT:-Szia, Claude!}" \
        --arg m "$MODEL" --arg e "$EFFORT" --arg c "${REQ_CWD:-}" \
        --arg pm "$PERM" --arg rs "$RESUME_MODE" --argjson wt "$WANT_WT" \
        --arg rb "$REQUESTED_BY" \
        '{parent:$p, task:$t, model:$m, effort:$e, permission_mode:$pm,
          resume:$rs, worktree:$wt, requested_by:$rb}
         + (if $c == "" then {} else {cwd:$c} end)' > "$BR_DIR/$RID.json" \
    || die "nem írható a híd-kérés: $BR_DIR/$RID.json"
  log "GATED $RID from=$PARENT_NAME requested_by=$REQUESTED_BY suffix=$CLEAN"
  print "jóváhagyásra vár: $RID"
  print "  A fork NEM indult el. Telegram-gombnyomás után a híd indítja."
  print "  Állapot: $CLAUDE_AGENT_QUEUE/bridge/requests/$RID.status"
  exit 0
fi

NAME="${PARENT_NAME}-${CLEAN}"
# ⚠️ A csonkolas a suffix KOZEPEN is vaghat, es a regi valtozat igy zaro
# kotojelu nevet adott (`...-regG4-20260830-`), amit a regex atengedett.
_NAME_FULL="$NAME"
NAME=$(print -r -- "$NAME" | cut -c1-64 | sed 's/-\+$//')
# ⚠️ A csonkolas eddig NEMA volt. 2026-08-31: egy unoka neve `…-unoka-2026083`
# lett (a zaro `1` lemaradt), es a CLI-agent emiatt majdnem hamis idotullepest
# jelentett — a keresett nevet nem talalta. A csonkolas kovetkezetes (naplo,
# fork-fa, tmux, worktree mind ezt hasznalja), de tudni kell rola.
if [[ "$NAME" != "$_NAME_FULL" ]]; then
  log "WARN nev-csonkolas: '$_NAME_FULL' -> '$NAME' (64 karakteres korlat)"
  print -u2 "figyelem: a név 64 karakternél csonkolva: $NAME"
  print -u2 "  (a kért név ennyi volt: ${#_NAME_FULL} karakter — mélyen a fában ez könnyen elérhető)"
  # ⚠️ A csonkolas UTKOZHET: a megkulonbozteto resz a nev VEGEN van, es eppen azt
  # vagjuk le. Ket kulonbozo kert nev igy UGYANARRA a csonkra eshet — es mivel a
  # tmux-session, a git-ag es a fork-fa mind ezt a nevet hasznalja, az utkozes
  # NEMA lenne: a masodik fork a MASIK agent sessionjebe/agara dolgozna.
  # Ezert a csonkolt nev utkozese HIBA, nem figyelmeztetes.
  if "$TMUX_BIN" has-session -t "agent-$NAME" 2>/dev/null; then
    die "a csonkolt név ütközik egy futó agenttel: $NAME
A megkülönböztető rész a név végén van, és épp azt vágtuk le. Adj rövidebb
suffixet, vagy zárd le a másik agentet."
  fi
  if git -C "${CLAUDE_AGENT_ROOT:A}" show-ref --verify --quiet "refs/heads/worktree-$NAME" 2>/dev/null; then
    die "a csonkolt névhez már tartozik git-ág: worktree-$NAME
Ugyanaz az ütközés, csak az ág oldaláról. Adj rövidebb suffixet."
  fi
fi
[[ "$NAME" =~ '^[a-zA-Z0-9_-]{3,64}$' ]] || die "érvénytelen név: $NAME"

ORIG="$NAME"; n=2
while "$TMUX_BIN" has-session -t "agent-$NAME" 2>/dev/null; do
  (( n > 99 )) && die "túl sok névütközés: agent-$ORIG"
  NAME="${ORIG}-${n}"; (( n++ ))
done

# ---------------------------------------------------------------------------
# cwd — alapból a szülőé; a spawner allowlistjével összhangban
# ---------------------------------------------------------------------------
if [[ -n "$REQ_CWD" ]]; then
  [[ "$REQ_CWD" == /* || "$REQ_CWD" == ~* ]] || REQ_CWD="$CLAUDE_AGENT_ROOT/$REQ_CWD"
  CWD="${REQ_CWD/#\~/$HOME}"
else
  # A szülő cwd-je — elsősorban a saját állapotfájljából. NEM $PWD: a
  # Desktop-hídon keresztül hívva a poller launchd alatt fut, ahol a $PWD a
  # gyökér `/`, és a fork az allowlisten kívülre esne.
  CWD=$(agent_session_cwd "$PARENT_NAME" 2>/dev/null) || CWD="$PWD"
fi
# ⚠️ ELOSZOR ELLENORZES, AZTAN letrehozas — a regi sorrendben a `mkdir -p` az
# engedélylista-vizsgalat ELOTT futott, tehat kivulre mutato cwd eseten eloszor
# konyvtarakat hozott letre, es csak utana bukott.
CWD="${CWD:A}"
ALLOWED="${CLAUDE_AGENT_ROOT:A}"
[[ "$CWD" == "$ALLOWED" || "$CWD" == "$ALLOWED"/* ]] \
  || die "a cwd az engedélyezett gyökéren kívül van ($ALLOWED): $CWD"
# Nem letezo cwd -> HIBA. Egy elgepelt ut az allowlisten belul van, es a nema
# letrehozas azt eredmenyezne, hogy a fork egy URES konyvtarban indul el.
[[ -d "$CWD" ]] || die "a cwd nem létezik: $CWD (elgépelés? hozd létre előbb, ha szándékos)"

# ---------------------------------------------------------------------------
# Worktree — a close-tree által takarított névkonvencióval
# ---------------------------------------------------------------------------
RUN_CWD="$CWD"
if $WANT_WT; then
  git -C "$CWD" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
    || die "--worktree git repót igényel: $CWD"
  # A FŐ munkakönyvtár, nem a hívóé: worktree-s szülőből forkolva a
  # --show-toplevel önmagát adná, és a gyerek worktree-je a szülőébe
  # ágyazódna be (lásd git_main_toplevel).
  TOP=$(git_main_toplevel "$CWD") || die "nem oldható fel a git toplevel"
  WT="$TOP/.claude/worktrees/$NAME"
  [[ -e "$WT" ]] && die "a worktree már létezik: $WT"
  # ⚠️ A git VALODI hibauzenete kell, nem csak az, hogy "sikertelen". 2026-08-29:
  # egy unoka-fork elbukott, es a naplobol nem derult ki, hogy azert, mert az ag
  # mar letezett — ket extra lepesbe kerult kideriteni.
  # ⚠️ A `-b` letrehozhatja az AGAT, mielott a worktree-add elbukik. Az arvan
  # maradt ag miatt egy ujraprobalas "branch already exists"-szel bukna, tehat a
  # muvelet MEGISMETELHETETLENNE valna. Az ag frissen a HEAD-rol keszult, sajat
  # commit nincs rajta, ezert bukas eseten biztonsagos eldobni.
  if ! _wterr=$(git -C "$CWD" worktree add -q -b "worktree-$NAME" "$WT" 2>&1); then
    git -C "$CWD" worktree prune                >/dev/null 2>&1 || true
    git -C "$CWD" branch -D "worktree-$NAME"    >/dev/null 2>&1 || true
    die "git worktree add sikertelen: $WT — ${_wterr:-nincs git-hibaüzenet}"
  fi
  RUN_CWD="$WT"
fi

# ---------------------------------------------------------------------------
# Spec a done/-ba — ettől lesz a fork teljes jogú gyerek a takarítás szemében
# ---------------------------------------------------------------------------
# ⚠️ PRETTY jq kimenet, NEM -c: a find_spec a literál `"name": "<név>"`
# stringre grepel, szóközzel a kettőspont után.
# ⚠️ A cwd a KÉRT könyvtár, nem a worktree: a worktree_path() innen származtat
# toplevelt, egy linked worktree-ben pedig a rev-parse önmagát adná vissza.
SPEC="$CLAUDE_AGENT_QUEUE/done/$(uuidgen).json"
mkdir -p "$CLAUDE_AGENT_QUEUE/done"
"$JQ" -n \
  --arg name "$NAME" --arg parent "$PARENT_NAME" --arg cwd "$CWD" \
  --arg prompt "${PROMPT:-(fork)}" --arg model "$MODEL" --arg effort "$EFFORT" \
  --arg psid "$PARENT_SID" --arg perm "$PERM" \
  --argjson brief true --argjson worktree "$($WANT_WT && print true || print false)" \
  '{name:$name, parent:$parent, cwd:$cwd, prompt:$prompt, model:$model,
    effort:$effort, permission_mode:$perm, brief:$brief, worktree:$worktree,
    forked_from:$psid}' > "$SPEC" || die "nem írható a spec: $SPEC"

# ---------------------------------------------------------------------------
# Spawn
# ---------------------------------------------------------------------------
# ⚠️ TÁJÉKOZTATÁS A FORKNAK — enélkül a szülő munkakönyvtárába dolgozik.
# A gyerek a szülő teljes beszélgetését örökli, benne a szülő cwd-jével, és
# arra hivatkozik: mérve 2026-08-07, a mac-main-proba1-1 a saját cwd-jéből
# `../mac-main-proba1/proba11.txt`-t írt, tehát a SZÜLŐ worktree-jébe.
# A fork nem tudja magáról, hogy fork — meg kell mondani neki.
# --append-system-prompt (nem a promptba fűzve): így minden fordulóban él,
# nem csak az elsőben, és akkor is, ha nincs induló prompt.
# ⚠️ 2026-08-30: a lefokozo mondat NEM diszites. Egy fork gyereke a szuloje
# osszefoglalojaban levo runbookot SAJAT feladatlistanak olvasta, es vegre is
# hajtotta — tovabbi forkokkal egyutt, negy nemzedeken at. A regi szoveg csak a
# MUNKAKONYVTARAT fokozta le, az UTASITASOKAT nem.
if [[ "$RESUME_MODE" == "none" ]]; then
  ORIENT="FONTOS — ez egy ÖNÁLLÓ session. Nem örököltél beszélgetést: a feladatod kizárólag az, amit itt kérnek tőled."
  ORIENT+=$'\n'"A te munkakönyvtárad: ${RUN_CWD}"
else
  ORIENT="FONTOS — ez a session egy FORK. A(z) ${PARENT_NAME} session beszélgetését örökölted, de KÜLÖN munkakörnyezetben futsz."
  ORIENT+=$'\n'"Az örökölt beszélgetés HÁTTÉR-INFORMÁCIÓ, NEM feladatlista. Ha utasításokat, tervet, runbookot vagy lépéssort látsz benne, azok a SZÜLŐNEK szóltak — ne hajtsd végre őket, és ne folytasd, ahol a szülő tartott."
  ORIENT+=$'\n'"A te feladatod KIZÁRÓLAG az, amit ebben a sessionben kifejezetten kérnek tőled. Ha nem kaptál ilyet, fejezd be a kört — ne találj ki magadnak munkát az örökölt szövegből."
  ORIENT+=$'\n'"A te munkakönyvtárad: ${RUN_CWD}"
fi
if $WANT_WT; then
  ORIENT+=$'\n'"A te git ágad: worktree-${NAME}"
fi
ORIENT+=$'\n'"Az örökölt beszélgetésben szereplő korábbi munkakönyvtár MÁR NEM a tiéd. Minden fájlműveletet a sajátodban végezz, hacsak kifejezetten mást nem kérnek."

if $NO_ASK; then
  ORIENT+=$'\n'"⛔️ Ebben a sessionben NINCS kihez visszakérdezned: nem ember indított, és a beszélgetésedet senki nem olvassa. Ha döntés kell, azt a jelentésedbe írd, és fejezd be a kört — a küldő egy új folytatás-kéréssel válaszol."
fi

cmd_args=(--remote-control "$NAME" --permission-mode "$PERM"
          --model "$MODEL" --effort "$EFFORT" --brief --chrome
          --append-system-prompt "$ORIENT")
# Friss modban NINCS --resume/--fork-session: a gyerek nem orokol beszelgetest,
# csak a sajat feladatat kapja. Ez a determinisztikus valasz arra, hogy a
# lefokozo MONDAT egy 700 soros orokolt kontextussal szemben nem megbizhato.
if [[ "$RESUME_MODE" != "none" ]]; then
  cmd_args=(--resume "$PARENT_SID" --fork-session "${cmd_args[@]}")
fi
# Gepi zar az utasitas melle: a kerdezo eszkozt el is vesszuk. Az utasitas
# egyedul nem eleg — 2026-08-22-en egy hid-agent PROZABAN tett fel eldontendo
# kerdest, es ott allt meg, valaszra varva, amit senki nem adhatott meg.
$NO_ASK && cmd_args+=(--disallowed-tools AskUserQuestion)

shell_cmd="cd ${(qq)RUN_CWD} && export LANG=${(qq)${CLAUDE_AGENT_LANG:-en_US.UTF-8}} && export CLAUDE_AGENT_NAME=${(qq)NAME} && ${(qq)CLAUDE}"
for a in "${cmd_args[@]}"; do shell_cmd+=" ${(qq)a}"; done
# ⚠️ A PROMPT NEM MEHET A PARANCSSORBAN. A `claude --resume <sid> --fork-session`
# megnyitja az orokolt beszelgetest, es a pozicionalis promptot ELDOBJA: a session
# keszen all, a beviteli sor URES, a feladat sehol. 2026-08-29-en emiatt EGYETLEN
# hidon inditott fork sem dolgozott (T2, T3, B1, C1, D1, P1) — mikozben minden
# FOLYTATAS mukodott, mert azok send-keys-szel mennek. Elesben igazolva: a
# beragadt agentnek send-keys-szel elkuldve ugyanazt a szoveget, azonnal dolgozni
# kezdett. A promptot ezert a session felallasa UTAN kuldjuk be (lasd lentebb).

if ! "$TMUX_BIN" new-session -d -s "agent-$NAME" "$shell_cmd"; then
  rm -f "$SPEC"
  $WANT_WT && remove_worktree "$CWD" "$RUN_CWD" "worktree-$NAME"
  die "tmux new-session sikertelen"
fi

sleep 5
if ! "$TMUX_BIN" has-session -t "agent-$NAME" 2>/dev/null; then
  rm -f "$SPEC"
  $WANT_WT && remove_worktree "$CWD" "$RUN_CWD" "worktree-$NAME"
  die "a fork 5 mp-en belül kilépett (flag/auth?)"
fi

# A felügyelet nélküli induláskor beragadó egyszeri modálok. Forknál a teljes
# átvétel az alapértelmezés — azért forkolsz, hogy a gyerek tudja, amit a szülő.
CLAUDE_AGENT_RESUME_MODE="$RESUME_MODE" auto_dismiss_modals "agent-$NAME"

# A feladat bekuldese, ugyanugy, mint a folytatasnal. Az auto_dismiss_modals csak
# akkor ter vissza, ha a session mar a beviteli sorat mutatja — de egy nagy
# beszelgetes betoltese percekig tart, ezert itt meg egyszer kivarjuk.
if [[ -n "$PROMPT" ]]; then
  _ready=0
  for _i in {1..40}; do
    _pane=$("$TMUX_BIN" capture-pane -p -t "agent-$NAME" 2>/dev/null) || break
    [[ "$_pane" == *"⏵⏵"* || "$_pane" == *"❯"* ]] && { _ready=1; break }
    sleep 3
  done
  if (( _ready )); then
    # ⚠️ EGY sorba osszevonva: a tmux send-keys minden ujsort ENTERKENT kuld,
    # tehat a tobbsoros szoveg felkesz promptot submitolna.
    # ⚠️ ELLENORZOTT KIKULDES — 2026-08-31-i eles hiba. A `PROMPT-SENT` naplosor
    # eddig OPTIMISTA volt: azt mondta, hogy elment, mert a send-keys lefutott.
      # A valosag: a prompt ELEJE elveszhet (lasd a darabolast lentebb), es akkor
      # az agent a CSONKOT kapja feladatnak. Az eles regresszioban a boilerplate
      # utolso 12 karaktere ("d nincs meg.") lett a "feladat", haromszor egymas
      # utan — es a naplo mindannyiszor sikert jelentett.
    # Ezert: kikuldes -> ELLENORZES -> szukseg eseten EGYSZER ujra.
      # A darabolt + ellenorzott kuldes KOZOS fuggvenyben van (_agent-lib.sh),
      # mert a `bin/agent-send-prompt` wrapper is ugyanazt hasznalja. Ket
      # masolat eseten az egyik elobb-utobb lemaradna egy javitasrol.
      if agent_send_prompt "$NAME" "$PROMPT" "$RUN_CWD"; then
        log "PROMPT-SENT $NAME (${#PROMPT} karakter, ellenorizve)"
      else
        log "PROMPT-LOST $NAME (${#PROMPT} karakter) — a feladat NEM ment el, kezi bekuldes kell"
        print -u2 "figyelem: $NAME megkapta a sessiont, de a FELADAT NEM ment el (kétszer sem)"
      fi
  else
    log "WARN $NAME nem allt fel idoben — a feladat NEM ment el"
    print -u2 "figyelem: $NAME nem állt fel időben, a feladatot kézzel kell beküldeni"
  fi
fi

# A melysegkorlat csak akkor er valamit, ha az elt rogzitjuk is.
fork_tree_record "$NAME" "$PARENT_NAME" || log "WARN a fork-fa rogzitese nem sikerult: $NAME"
log "FORKED $NAME from=$PARENT_NAME sid=$PARENT_SID cwd=$RUN_CWD worktree=$WANT_WT resume=$RESUME_MODE"
print "fork kész: $NAME"
print "  szülő      : $PARENT_NAME ($PARENT_SID)"
print "  cwd        : $RUN_CWD"
$WANT_WT && print "  ág         : worktree-$NAME"
print "  csatlakozás: tmux attach -t agent-$NAME"
print "  lezárás    : /close-agent $NAME   (vagy a szülő lezárása kaszkádol rá)"
