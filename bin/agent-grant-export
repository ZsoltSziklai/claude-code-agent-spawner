#!/usr/bin/env zsh
# agent-grant-export <felhatalmazas-id> — a felhatalmazas teljes rekordja JSON-ban.
#
# A replikacios csomagnak szol: KI, MIKOR, MIRE adott engedelyt, es mi tortent
# alatta. A biralo kerdese ("ki mit engedelyezett kinek") igy egy adatfajllal
# valaszolhato meg, nem egy kezzel bepotyogott beallitas-fajllal.
#   .grant  — a jovahagyott keret (szulok, darabszam, ora, parhuzamossag, modell,
#             --no-ask, kervenyezo, celkituzes, jovahagyas ideje es Telegram-fiokja,
#             felhasznalt darabszam, leallitas)
#   .forks  — minden fork, ami ALATTA indult, a fork.log alapjan (ido, nev, szulo)
set -u
HERE="${${(%):-%x}:A:h}"
source "$HERE/_bridge-lib.sh" || { print -u2 "a híd-könyvtár nem töltődött be"; exit 2 }
[[ $# -eq 1 ]] || { print -u2 "használat: agent-grant-export <felhatalmazás-id>"; exit 2 }
id="$1"
rec=$(xgrant_get "$id") || { print -u2 "nincs ilyen kísérlet-felhatalmazás: $id"; exit 1 }
log="$CLAUDE_AGENT_QUEUE/fork.log"
forks=$(grep FORKED "$log" 2>/dev/null | grep -F " grant=$id" \
  | awk '{n="";p=""; for(i=1;i<=NF;i++){ if($i=="FORKED") n=$(i+1); if($i ~ /^from=/) p=substr($i,6) } print $1"\t"n"\t"p}' \
  | jq -R -s 'split("\n") | map(select(length>0) | split("\t") | {ts:.[0], name:.[1], parent:.[2]})')
jq -n --arg id "$id" --argjson g "$rec" --argjson f "${forks:-[]}" \
      --arg host "$(hostname -s)" --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
  '{id:$id, exported_at:$at, host:$host, grant:$g, forks:$f, fork_count:($f|length)}'
